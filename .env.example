# ──────────────────────────────────────────────
# Meta-LLM-Selector — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
#   cp .env.example .env

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Exa Search API Key (required)
# Get yours at: https://dashboard.exa.ai/api-keys
EXA_API_KEY=your_exa_api_key_here

# ──────────────────────────────────────────────
# Optional: Model configuration
# ──────────────────────────────────────────────
# LLM model used by CrewAI agents.
# CrewAI sends a system prompt for every agent (role/goal/backstory).
# ⚠️  Gemma on Google AI Studio does NOT support system prompts and will
#     return 400 INVALID_ARGUMENT: Developer instruction is not enabled.
#     To use Gemma, route through Groq (see below).

# ── Recommended (Google AI Studio — GEMINI_API_KEY) ──────────────────────
CREW_MODEL=gemini/gemini-2.5-flash        # default — supports system prompts
# CREW_MODEL=gemini/gemini-2.5-flash-lite  # faster / cheaper

# ── Gemma via Groq (GROQ_API_KEY — supports system prompts) ──────────────
# Groq free tier: 14,400 req/day. Get key at https://console.groq.com/keys
# CREW_MODEL=groq/gemma2-9b-it             # Gemma 2 9B — best Groq/Gemma option
# GROQ_API_KEY=your_groq_api_key_here

# ── Other providers ───────────────────────────────────────────────────────
# CREW_MODEL=gpt-4o                        # OpenAI (OPENAI_API_KEY)
# CREW_MODEL=anthropic/claude-3-5-sonnet-20241022  # Anthropic (ANTHROPIC_API_KEY)

# Disable CrewAI telemetry / tracing interactive prompts
CREWAI_TRACING_ENABLED=false
