# ──────────────────────────────────────────────
# Meta-LLM-Selector — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
#   cp .env.example .env

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Exa Search API Key (required)
# Get yours at: https://dashboard.exa.ai/api-keys
EXA_API_KEY=your_exa_api_key_here

# ──────────────────────────────────────────────
# Optional: Model configuration
# ──────────────────────────────────────────────
# LLM model used by CrewAI agents (default: gemini/gemini-2.5-flash)
# gemini-2.5-flash is available on free tier across all regions.
# Alternatives: gemini/gemini-2.5-flash-lite (faster/cheaper)
CREW_MODEL=gemini/gemma-3-27b-it

# Other available models:
# gemini/gemma-3-27b-it          ← Gemma 3 27B (best Gemma, same API key, free tier)
# gemini/gemma-3-12b-it          ← Gemma 3 12B (faster, slightly less capable)
# gemini/gemini-2.5-flash        ← Gemini 2.5 Flash (original default)
# gemini/gemini-2.5-flash-lite   ← Gemini 2.5 Flash Lite (fastest/cheapest)

# Disable CrewAI telemetry / tracing interactive prompts
CREWAI_TRACING_ENABLED=false
